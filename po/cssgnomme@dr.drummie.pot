#: src/prefs.js:1190
msgid "CSS Gnommé - Dynamic GTK Theme Overlay for Zorin OS"
msgstr ""

#: src/prefs.js:1195
msgid "Version"
msgstr ""

#: src/prefs.js:1195
msgid "Author"
msgstr ""

#: src/prefs.js:1196
msgid ""
"Developed for Zorin OS 17.3 (GNOME Shell 43-44), inspired by Cinnamon CSS "
"Panels and gnome Open Bar extensions."
msgstr ""

#: src/prefs.js:1204
msgid "How It Works"
msgstr ""

#: src/prefs.js:1209
msgid "Overlay Theme System"
msgstr ""

#: src/prefs.js:1210
msgid ""
"Creates a dynamic overlay at ~/.themes/CSSGnomme/ that sits on top of your "
"current theme via @import. Fully reversible, doesn't modify original theme "
"files."
msgstr ""

#: src/prefs.js:1217
msgid ""
"Analyzes wallpaper using K-means clustering, extracts dominant and accent "
"colors, applies darker variants to panels and brighter variants to menus. "
"Triggers on wallpaper change or manually."
msgstr ""

#: src/prefs.js:1223
msgid "Advanced Blur Effects"
msgstr ""

#: src/prefs.js:1224
msgid ""
"Uses CSS backdrop-filter for frosted glass appearance. All settings (radius, "
"saturate, contrast, brightness) dynamically read from preferences. Applies "
"to menus, Alt+Tab, and shell elements."
msgstr ""

#: src/prefs.js:1230
msgid "Zorin OS Integration"
msgstr ""

#: src/prefs.js:1231
msgid ""
"Enhanced styling for Zorin Taskbar and panels. Note: Window Preview uses "
"inline JavaScript styles that override CSS."
msgstr ""

#: src/prefs.js:1237
msgid "What Gets Styled"
msgstr ""

#: src/prefs.js:1238
msgid ""
"GNOME Shell panel, Zorin taskbar, popup menus, Alt+Tab switcher, Quick "
"Settings, notifications, OSD, and Dash. GTK3/GTK4 apps inherit base theme "
"with optional overrides."
msgstr ""

#: src/prefs.js:1244
msgid "Known Limitations"
msgstr ""

#: src/prefs.js:1245
msgid ""
"Theme switching: Flicker on theme refresh. Window Preview: Zorin Taskbar "
"uses inline JavaScript styles that override CSS. Wayland: Shell restart "
"requires logout. Performance: Heavy blur (radius > 40px) may impact older "
"GPUs."
msgstr ""

